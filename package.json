{
  "name": "ndis-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down",
    "db:migrate": "dotenv -e .env -- bash -c 'for f in db/migrations/*.sql; do echo \"Applying $f\"; psql \"$DATABASE_URL\" -f \"$f\"; done'",
    "db:codegen": "dotenv -e .env -- kysely-codegen --dialect postgres --out-file db/types.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.5.2",
    "argon2": "^0.44.0",
    "bignumber.js": "^11.1.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "kysely": "^0.29.4",
    "lodash": "^4.18.1",
    "minio": "^8.0.7",
    "next": "16.2.12",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
